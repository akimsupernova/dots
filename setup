#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
ICONS_DIR="$HOME/.icons"
BACKUP_BASE="$HOME/.local/share/akim-dotfiles-backup"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/akim-dotfiles"
MANIFEST="$STATE_DIR/manifest"
BACKUP_REF="$STATE_DIR/backup_dir"
BACKUP_ROOT=""

ASSUME_YES=0
DRY_RUN=0
SKIP_DEPS=0
TMP_DIRS=()

PACKAGES=(
  ttf-google-sans awww nwg-look qt5ct qt6ct mpvpaper kitty fish fontconfig pipewire pipewire-jack pipewire-pulse polkit python ddcutil
  btop nvtop lact quickshell kate zen-browser-bin noto-fonts-extra pipewire-alsa alsa-utils wireplumber pavucontrol sof-firmware brightnessctl
  bibata-cursor-theme grim slurp wl-clipboard noto-fonts noto-fonts-cjk noto-fonts-emoji dolphin obs-studio ffmpeg xdg-desktop-portal xdg-desktop-portal-hyprland
)

info() { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; exit 1; }

cleanup() {
  local d
  for d in "${TMP_DIRS[@]:-}"; do
    if [[ -n "$d" && -d "$d" ]]; then
      rm -rf "$d"
    fi
  done
  return 0
}
on_err() {
  local rc=$? line="$1"
  trap - ERR
  die "Failed (exit $rc) at line $line: $BASH_COMMAND"
}
trap cleanup EXIT
trap 'on_err "$LINENO"' ERR

usage() {
  cat <<'USAGE'
Dotfiles setup (Arch Linux / CachyOS)

Usage: ./setup [options] <command>

Commands:
  install     Install packages, then install the dotfiles.
  uninstall   Remove the installed dotfiles and restore the original configs.
  deps        Install yay + packages only.
  help        Show this help.

Options:
  -y, --yes       Do not ask for confirmation
  -n, --dry-run   Show what would be done without changing anything
      --no-deps   (install) skip package installation, dotfiles only
USAGE
}

confirm() {
  if ((ASSUME_YES)); then return 0; fi
  local ans
  read -r -p "$1 [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

run() {
  if ((DRY_RUN)); then
    printf '\033[1;35m[DRY]\033[0m %s\n' "$*"
  else
    "$@"
  fi
}

check_arch() {
  [[ -r /etc/arch-release ]] || die "This script targets Arch Linux / CachyOS and derivatives."
  command -v pacman >/dev/null 2>&1 || die "pacman was not found."
}

check_not_root() {
  [[ "$EUID" -ne 0 ]] || die "Do not run this script as root; run it as your normal user. sudo is used when needed."
}

install_yay() {
  if command -v yay >/dev/null 2>&1; then
    info "yay is already installed."
    return
  fi

  warn "Installing base-devel and git (no full system upgrade)."
  run sudo pacman -S --needed base-devel git

  local build_dir
  build_dir="$(mktemp -d "${TMPDIR:-/tmp}/yay-build.XXXXXX")"
  TMP_DIRS+=("$build_dir")

  info "Cloning yay from the AUR and building it as the current user..."
  run git clone --depth 1 https://aur.archlinux.org/yay.git "$build_dir/yay"
  if ((DRY_RUN)); then
    run makepkg -si --needed
  else
    (cd "$build_dir/yay" && makepkg -si --needed)
    command -v yay >/dev/null 2>&1 || die "yay installation did not complete successfully."
  fi
}

install_packages() {
  check_arch
  check_not_root
  install_yay
  info "Syncing databases and installing packages..."
  run yay -Sy --needed --noconfirm "${PACKAGES[@]}"
  post_install
}

post_install() {
  if command -v fc-cache >/dev/null 2>&1; then
    run fc-cache -f >/dev/null 2>&1 || true
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files lactd.service >/dev/null 2>&1; then
    if confirm "Enable lactd.service (required by LACT)?"; then
      run sudo systemctl enable --now lactd.service
    fi
  fi
}

target_dir() {
  case "$1" in
    .config) printf '%s' "$CONFIG_DIR" ;;
    .icons)  printf '%s' "$ICONS_DIR" ;;
    *) die "Unknown label: $1" ;;
  esac
}

manifest_lookup() {
  [[ -f "$MANIFEST" ]] || return 1
  local label name had
  while IFS=$'\t' read -r label name had; do
    if [[ "$label" == "$1" && "$name" == "$2" ]]; then
      printf '%s' "$had"
      return 0
    fi
  done < "$MANIFEST"
  return 1
}

manifest_add() {
  if ((DRY_RUN)); then return 0; fi
  mkdir -p "$STATE_DIR"
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$MANIFEST"
}

init_backup_root() {
  if [[ -f "$BACKUP_REF" ]]; then
    BACKUP_ROOT="$(<"$BACKUP_REF")"
  else
    BACKUP_ROOT="$BACKUP_BASE/$(date +%Y%m%d-%H%M%S)"
    if ((DRY_RUN)); then return 0; fi
    mkdir -p "$STATE_DIR"
    printf '%s' "$BACKUP_ROOT" > "$BACKUP_REF"
  fi
}

deploy_item() {
  local src="$1" label="$2"
  local name dest_dir dest
  name="$(basename "$src")"
  dest_dir="$(target_dir "$label")"
  dest="$dest_dir/$name"

  case "$name" in .git|.gitignore|.DS_Store) return 0 ;; esac

  if manifest_lookup "$label" "$name" >/dev/null; then
    info "Updating $label/$name"
    run rm -rf "$dest"
  else
    local had=0
    if [[ -e "$dest" || -L "$dest" ]]; then
      had=1
      info "Moving existing $label/$name -> backup"
      run mkdir -p "$BACKUP_ROOT/$label"
      run mv "$dest" "$BACKUP_ROOT/$label/"
    fi
    manifest_add "$label" "$name" "$had"
    info "Installing $label/$name"
  fi
  run cp -a "$src" "$dest_dir/"
}

do_install() {
  check_not_root

  local -a config_items=()
  local item
  while IFS= read -r -d '' item; do
    config_items+=("$item")
  done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name 'icons' -print0 | sort -z)
  [[ ${#config_items[@]} -gt 0 ]] || die "No config folders found in $ROOT."

  if ((SKIP_DEPS)); then
    info "Skipping package installation (--no-deps)."
  else
    install_packages
  fi

  init_backup_root
  run mkdir -p "$CONFIG_DIR"
  for item in "${config_items[@]}"; do
    deploy_item "$item" ".config"
  done

  if [[ -d "$ROOT/icons" ]]; then
    run mkdir -p "$ICONS_DIR"
    while IFS= read -r -d '' item; do
      deploy_item "$item" ".icons"
    done < <(find "$ROOT/icons" -mindepth 1 -maxdepth 1 -print0 | sort -z)
  else
    warn "No icons folder found; skipping."
  fi

  if [[ -d "$BACKUP_ROOT" ]]; then
    info "Previous configs saved in: $BACKUP_ROOT"
  fi
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  echo
  info "Dotfiles installed. To undo: ./setup uninstall"
  info "After rebooting, press 'SUPER + /' to see the key binding cheatsheet"
  info "Now reboot and have fun!"
  echo
  echo "===== IGNORE THE ERROR WARNING IF YOU SEE THIS JUST REBOOT YOUR SYSTEM ====="
  echo
  mkdir -p ~/.cache/awww
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then

    if ! pgrep -x awww-daemon >/dev/null; then
      setsid nohup awww-daemon >/dev/null 2>&1 &
      disown
    fi

    for _ in {1..20}; do
      awww query >/dev/null 2>&1 && break
      sleep 0.25
    done
    awww img ~/.config/quickshell/assets/wallpaper/default-wallpaper.png 2>/dev/null || true
  fi

  if ((DRY_RUN)); then
    info "[dry-run] would reboot in 5 seconds."
    return 0
  fi
  for i in 5 4 3 2 1; do
    printf '\r\033[1;34m[INFO]\033[0m Rebooting in %s... (Ctrl+C to cancel) ' "$i"
    sleep 1
  done
  echo
  reboot
}

do_uninstall() {
  check_not_root
  [[ -f "$MANIFEST" ]] || die "No install record found at $MANIFEST; nothing to uninstall."
  [[ -f "$BACKUP_REF" ]] || die "Backup location record is missing ($BACKUP_REF)."
  BACKUP_ROOT="$(<"$BACKUP_REF")"

  warn "Installed dotfiles will be removed (manual changes to them are lost),"
  warn "and your original configs will be restored from: $BACKUP_ROOT"
  confirm "Continue with uninstall?" || die "Cancelled."

  local label name had dest_dir dest saved
  while IFS=$'\t' read -r label name had; do
    [[ -n "$label" ]] || continue
    dest_dir="$(target_dir "$label")"
    dest="$dest_dir/$name"
    saved="$BACKUP_ROOT/$label/$name"

    if [[ -e "$dest" || -L "$dest" ]]; then
      run rm -rf "$dest"
    fi
    if [[ "$had" == "1" ]]; then
      if [[ -e "$saved" || -L "$saved" ]]; then
        info "Restoring $label/$name"
        run mkdir -p "$dest_dir"
        run mv "$saved" "$dest_dir/"
      else
        warn "Backup of $label/$name not found at $saved; skipping."
      fi
    else
      info "Removing $label/$name (did not exist before)"
    fi
  done < "$MANIFEST"

  if ((DRY_RUN)); then
    info "[dry-run] done; nothing was changed."
    return 0
  fi

  rm -f "$MANIFEST" "$BACKUP_REF"
  rmdir "$STATE_DIR" 2>/dev/null || true
  find "$BACKUP_ROOT" -depth -type d -empty -delete 2>/dev/null || true
  rmdir "$BACKUP_BASE" 2>/dev/null || true
  if [[ -d "$BACKUP_ROOT" ]]; then
    warn "Leftovers remain in $BACKUP_ROOT (not created by this script); not removed."
  fi
  info "Uninstall complete. Your original configs have been restored."
}

CMD=""
for arg in "$@"; do
  case "$arg" in
    -y|--yes)     ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --no-deps)    SKIP_DEPS=1 ;;
    -h|--help)    CMD="help" ;;
    -*)           usage; die "Unknown option: $arg" ;;
    *)            CMD="$arg" ;;
  esac
done

case "${CMD:-help}" in
  install)   do_install ;;
  uninstall) do_uninstall ;;
  deps)      install_packages ;;
  help)      usage ;;
  *)         usage; die "Unknown command: $CMD" ;;
esac

