#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
ICONS_DIR="$HOME/.icons"
FONTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
BACKUP_BASE="$HOME/.local/share/akim-dotfiles-backup"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/glassveil-shell"
MANIFEST="$STATE_DIR/manifest"
BACKUP_REF="$STATE_DIR/backup_dir"
LOG_FILE="$STATE_DIR/last-command.log"
WELCOME_PENDING="$STATE_DIR/welcome-pending"
SPEC_FILE="$CONFIG_DIR/glassveil/spec.txt"
BACKUP_ROOT=""
PRESERVE_DIR=""

ASSUME_YES=0
DRY_RUN=0
SKIP_DEPS=0
REBOOT_MODE="ask"
NEED_RELOGIN=0
PM_FLAGS=()
STEP=""
LAST_CMD=""
FAIL_TEXT=""
HINTED=0
TMP_DIRS=()
SUDO_KEEPALIVE_PID=""
LOG_FROM=""
IN_PTY=0
if [[ "${GLASSVEIL_SETUP_PTY:-}" == "1" ]]; then IN_PTY=1; fi

CONFIG_DIRS=(fish gtk-3.0 gtk-4.0 hypr kitty nwg-look qt5ct qt6ct quickshell)
PRESERVE=(hypr/modules/monitors.lua hypr/custom/keybinds.lua)
KEEP_ON_FIRST=(hypr/custom/keybinds.lua)

PACKAGES=(
  ark awww nwg-look qt5ct qt6ct mpvpaper kitty fish fontconfig pipewire pipewire-pulse polkit python ddcutil
  btop nvtop lact quickshell kate firefox noto-fonts-extra pipewire-alsa alsa-utils wireplumber pavucontrol sof-firmware brightnessctl
  bibata-cursor-theme-bin grim slurp wl-clipboard noto-fonts noto-fonts-cjk noto-fonts-emoji dolphin obs-studio ffmpeg xdg-desktop-portal xdg-desktop-portal-hyprland
  libnotify kvantum kvantum-qt5 curl zenity poppler dconf gsettings-desktop-schemas
  cava playerctl xdg-utils python-pillow qt6-svg breeze-icons konsole ttf-jetbrains-mono-nerd
  hyprland hyprsunset networkmanager bluez bluez-utils upower ffmpegthumbs
  adwaita-fonts adwaita-icon-theme xdg-desktop-portal-gtk qt6-wayland qt5-wayland pciutils
)

info() { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; exit 1; }
step() { STEP="$1"; printf '\n\033[1;32m==>\033[0m %s\n' "$1"; }

hint() {
  local title="$1" line
  shift
  HINTED=1
  printf '\n\033[1;33m>> %s\033[0m\n' "$title" >&2
  for line in "$@"; do
    printf '   %s\n' "$line" >&2
  done
}

has() { grep -qiE -- "$1" <<<"$FAIL_TEXT"; }

explain_failure() {
  HINTED=0

  if has 'unable to lock database|db\.lck'; then
    hint "The package database is locked" \
      "Another pacman/yay may still be running (check: ps aux | grep -E 'pacman|yay')." \
      "If nothing is running, remove the stale lock:  sudo rm /var/lib/pacman/db.lck"
  fi

  if has 'unresolvable package conflicts|are in conflict|breaks dependency|conflicts with'; then
    hint "Two packages conflict with each other" \
      "Read the lines above to see which packages conflict (for example pipewire-jack vs jack2)." \
      "Remove the one you do not need:  sudo pacman -Rns <conflicting-package>" \
      "Or run ./setup install again WITHOUT --yes and answer y when pacman/yay asks to remove/replace a package" \
      "(--yes passes --noconfirm, which answers N to that question)."
  fi

  if has 'conflicting files|exists in filesystem'; then
    hint "Files from the package already exist on your system" \
      "pacman will not overwrite files it does not own. Find the owner:  pacman -Qo /path/from/the/error" \
      "If no package owns the file, move it away (mv /path /path.bak) and run ./setup install again." \
      "Last resort, only if you are sure:  sudo pacman -S --overwrite '<glob>' <package>"
  fi

  if has 'invalid or corrupted package|unknown trust|signature from .* is (unknown|invalid)|keyring'; then
    hint "Signature / keyring problem" \
      "Refresh the keyring, then upgrade:  sudo pacman -Sy archlinux-keyring && sudo pacman -Su" \
      "On CachyOS also update cachyos-keyring. If it still fails:  sudo pacman-key --init && sudo pacman-key --populate"
  fi

  if has 'PGP signatures? could not be verified|unknown public key'; then
    hint "An AUR package could not verify a PGP key" \
      "Import the key shown in the error:  gpg --recv-keys <KEYID>" \
      "Then run ./setup install again."
  fi

  if has 'failed retrieving file|error: failed to synchronize|failed to download|returned a 404|404 Not Found'; then
    hint "Could not download a package (404 / mirror problem)" \
      "Your package databases or mirrors are out of date. Run a full upgrade:  sudo pacman -Syu" \
      "If it keeps failing, refresh the mirror list (Arch: reflector, CachyOS: cachyos-rate-mirrors) and retry."
  fi

  if has 'could not resolve host|temporary failure in name resolution|network is unreachable|connection (timed out|refused)'; then
    hint "Network problem" \
      "Check your connection (ping archlinux.org) and DNS, then run ./setup install again."
  fi

  if has 'target not found|could not find all required packages|was not found'; then
    hint "A package was not found" \
      "The name may have changed or the package may have been removed. Search for it:  yay -Ss <name>" \
      "Then edit the PACKAGES list at the top of this script (or install an alternative by hand) and run again."
  fi

  if has 'could not satisfy dependencies|unable to satisfy dependency'; then
    hint "Dependencies could not be satisfied" \
      "Run a full upgrade first:  sudo pacman -Syu   (do not use -Sy alone: partial upgrades break Arch)." \
      "If the missing dependency is an AUR package, install it first:  yay -S <dependency>"
  fi

  if has 'not enough free disk space|no space left on device'; then
    hint "Not enough disk space" \
      "Check free space:  df -h" \
      "Clean the package cache:  sudo pacman -Sc   and the AUR build cache:  yay -Sc"
  fi

  if has 'a failure occurred in (build|prepare|package|check)|==> ERROR|error: failed to build'; then
    hint "An AUR package failed to build" \
      "Build it alone to see the full output:  yay -S <package>   (the package name is in the lines above)." \
      "Make sure the build tools are installed:  sudo pacman -S --needed base-devel" \
      "Clear the build cache and retry:  yay -Sc   then   yay -S <package>" \
      "Check the package's AUR page comments (https://aur.archlinux.org/packages/<package>) for a known problem." \
      "After installing the missing packages by hand, continue with:  ./setup install --no-deps"
  fi

  if has 'sudo: .*(password|terminal)|no tty present'; then
    hint "sudo could not ask for your password" \
      "Run this script from a normal terminal (not through a pipe or a non-interactive shell)."
  fi

  case "$STEP" in
    *dotfiles*|*icons*|*fonts*|*Backing*)
      hint "Copying files failed" \
        "Check free disk space (df -h) and the permissions of $CONFIG_DIR, ~/.icons and ~/.local/share." \
        "Your original files are safe in: ${BACKUP_ROOT:-$BACKUP_BASE}" \
        "Fix the problem and run ./setup install again, or undo with ./setup uninstall."
      ;;
  esac

  if ((!HINTED)); then
    hint "No known cause matched" \
      "Read the output above. The full output of the failing command is saved in: $LOG_FILE" \
      "Try running the failing command by hand to see the complete message:  ${LAST_CMD:-$BASH_COMMAND}"
  fi
}

on_err() {
  local rc="$1" line="$2" cmd="$3" shown
  trap - ERR
  set +e
  if [[ -n "$LOG_FROM" && -s "$LOG_FILE" ]]; then
    if ((IN_PTY)); then sleep 0.3; fi
    FAIL_TEXT="$(tail -c +"$((LOG_FROM + 1))" "$LOG_FILE" 2>/dev/null | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r//g' -e '/^Script \(started\|done\) on /d' 2>/dev/null)"
  fi
  printf '\n\033[1;31m[ERROR]\033[0m Setup stopped (exit code %s, script line %s).\n' "$rc" "$line" >&2
  if [[ -n "$STEP" ]]; then
    printf '  Step    : %s\n' "$STEP" >&2
  fi
  shown="${LAST_CMD:-$cmd}"
  if ((${#shown} > 150)); then
    shown="${shown:0:150} ..."
  fi
  printf '  Command : %s\n' "$shown" >&2
  if [[ -n "$FAIL_TEXT" ]]; then
    printf '  Last output:\n' >&2
    printf '%s\n' "$FAIL_TEXT" | tail -n 12 | sed 's/^/    | /' >&2
  fi
  explain_failure
  printf '\n\033[1;34m>> How to continue\033[0m\n' >&2
  printf '   1. Fix the problem using the steps above.\n' >&2
  printf '   2. Run ./setup install again. It is safe to repeat: installed packages are skipped and\n' >&2
  printf '      the dotfiles are simply updated. If you installed the packages yourself, use:\n' >&2
  printf '      ./setup install --no-deps\n' >&2
  printf '   3. To undo everything:  ./setup uninstall   (your original configs are restored)\n' >&2
  exit "$rc"
}

cleanup() {
  local d
  if [[ -n "$SUDO_KEEPALIVE_PID" ]]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    SUDO_KEEPALIVE_PID=""
  fi
  for d in "${TMP_DIRS[@]:-}"; do
    if [[ -n "$d" && -d "$d" ]]; then
      rm -rf "$d"
    fi
  done
  return 0
}

trap cleanup EXIT
trap 'on_err "$?" "$LINENO" "$BASH_COMMAND"' ERR
trap 'printf "\n"; warn "Interrupted."; exit 130' INT
trap 'exit 143' TERM HUP

usage() {
  cat <<'USAGE'
Dotfiles setup (Arch Linux / CachyOS)

Usage: ./setup [options] <command>

Commands:
  install     Install packages, then install the dotfiles.
  uninstall   Remove the installed dotfiles and restore the original configs.
  deps        Install yay + packages only.
  specs       Write the PC specs file (~/.config/glassveil/spec.txt) for the AI panel again.
  welcome     Show the welcome card again at the next login.
  help        Show this help.

Options:
  -y, --yes       Answer yes to every question and pass --noconfirm to pacman/yay.
                  Does not reboot by itself (add --reboot for that).
  -n, --dry-run   Show what would be done without changing anything.
  --no-deps       (install) skip package installation, dotfiles only.
  --reboot        Reboot when finished.
  --no-reboot     Do not reboot (default).

If something fails, the script prints the failing step, the last lines of output and
how to fix the usual causes by hand (package conflicts, mirrors, keyring, locks...).
It is safe to run ./setup install again afterwards.
USAGE
}

confirm() {
  local def="${2:-n}" prompt ans
  if ((ASSUME_YES)); then
    return 0
  fi
  if [[ "$def" == "y" ]]; then prompt="[Y/n]"; else prompt="[y/N]"; fi
  if ! read -r -p "$1 $prompt " ans; then
    ans=""
  fi
  if [[ -z "$ans" ]]; then ans="$def"; fi
  [[ "$ans" =~ ^[Yy]$ ]]
}

run() {
  if ((DRY_RUN)); then
    printf '\033[1;35m[DRY]\033[0m %s\n' "$*"
    return 0
  fi
  LAST_CMD="$*"
  "$@"
  LAST_CMD=""
}

run_logged() {
  LAST_CMD="$*"
  if ((DRY_RUN)); then
    printf '\033[1;35m[DRY]\033[0m %s\n' "$*"
    LAST_CMD=""
    return 0
  fi
  mkdir -p "$STATE_DIR"
  local rc=0
  if ((IN_PTY)); then
    LOG_FROM="$(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)"
    "$@" || rc=$?
  else
    : > "$LOG_FILE"
    LOG_FROM=0
    "$@" 2>&1 | tee "$LOG_FILE" || rc=$?
  fi
  if ((rc != 0)); then
    return "$rc"
  fi
  LOG_FROM=""
  LAST_CMD=""
}

build_flags() {
  PM_FLAGS=()
  if ((ASSUME_YES)); then
    PM_FLAGS+=(--noconfirm)
  fi
}

check_arch() {
  [[ -r /etc/arch-release ]] || die "This script targets Arch Linux / CachyOS and derivatives."
  command -v pacman >/dev/null 2>&1 || die "pacman was not found."
}

check_not_root() {
  [[ "$EUID" -ne 0 ]] || die "Do not run this script as root; run it as your normal user. sudo is used when needed."
}

setup_sudo() {
  if ((DRY_RUN)); then return 0; fi
  command -v sudo >/dev/null 2>&1 || die "sudo was not found."
  if ! sudo -n true 2>/dev/null; then
    sudo -v || die "sudo authentication failed."
  fi
  local parent="$$"
  (
    trap - ERR EXIT
    while kill -0 "$parent" 2>/dev/null; do
      sudo -n -v 2>/dev/null || true
      sleep 30
    done
  ) &
  SUDO_KEEPALIVE_PID=$!
}

install_yay() {
  if command -v yay >/dev/null 2>&1; then
    info "yay is already installed."
    return 0
  fi

  step "Installing base-devel and git (needed to build yay)"
  run_logged sudo pacman -S --needed "${PM_FLAGS[@]}" base-devel git

  local build_dir
  build_dir="$(mktemp -d "${TMPDIR:-/tmp}/yay-build.XXXXXX")"
  TMP_DIRS+=("$build_dir")

  step "Cloning yay from the AUR"
  run_logged git clone --depth 1 https://aur.archlinux.org/yay.git "$build_dir/yay"

  step "Building and installing yay (makepkg)"
  if ((DRY_RUN)); then
    run_logged makepkg -si --needed "${PM_FLAGS[@]}"
    return 0
  fi
  pushd "$build_dir/yay" >/dev/null
  run_logged makepkg -si --needed "${PM_FLAGS[@]}"
  popd >/dev/null
  if ! command -v yay >/dev/null 2>&1; then
    die "yay was built but is not in PATH. Install it by hand: https://github.com/Jguer/yay#installation"
  fi
}

setup_ddc() {
  if ! command -v ddcutil >/dev/null 2>&1; then
    return 0
  fi
  if ! confirm "Set up DDC/CI access for monitor brightness (load i2c-dev at boot, add you to the 'i2c' group)?" y; then
    return 0
  fi
  step "Configuring i2c access for ddcutil"
  run sudo modprobe i2c-dev || warn "Could not load i2c-dev now; it will load at next boot."
  if ((DRY_RUN)); then
    info "[dry-run] would write i2c-dev to /etc/modules-load.d/i2c-dev.conf"
  else
    printf 'i2c-dev\n' | sudo tee /etc/modules-load.d/i2c-dev.conf >/dev/null
  fi
  if ! getent group i2c >/dev/null 2>&1; then
    run sudo groupadd --system i2c
  fi
  if [[ " $(id -nG) " != *" i2c "* ]]; then
    run sudo usermod -aG i2c "$USER"
    NEED_RELOGIN=1
  fi
}

enable_service() {
  local unit="$1" why="$2"
  command -v systemctl >/dev/null 2>&1 || return 0
  if systemctl is-enabled --quiet "$unit" 2>/dev/null && systemctl is-active --quiet "$unit" 2>/dev/null; then
    return 0
  fi
  if confirm "Enable $unit ($why)?" y; then
    run sudo systemctl enable --now "$unit" || warn "Could not enable $unit. Run later: sudo systemctl enable --now $unit"
  fi
}

setup_network() {
  command -v systemctl >/dev/null 2>&1 || return 0
  command -v nmcli >/dev/null 2>&1 || return 0
  if systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    return 0
  fi
  if systemctl is-active --quiet iwd.service systemd-networkd.service connman.service 2>/dev/null; then
    warn "Another network manager is running. The sidebar Wi-Fi menu needs NetworkManager; switch only if you want to: sudo systemctl enable --now NetworkManager"
    return 0
  fi
  enable_service NetworkManager.service "needed by the sidebar Wi-Fi menu"
}

post_install() {
  step "Finishing package setup"
  if command -v fc-cache >/dev/null 2>&1; then
    run fc-cache -f >/dev/null 2>&1 || true
  fi

  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files lactd.service 2>/dev/null | grep -q '^lactd.service'; then
    if confirm "Enable lactd.service (required by LACT)?"; then
      run sudo systemctl enable --now lactd.service || warn "Could not enable lactd.service. Run later: sudo systemctl enable --now lactd.service"
    fi
  fi

  setup_network
  if command -v bluetoothctl >/dev/null 2>&1; then
    enable_service bluetooth.service "needed by the sidebar Bluetooth menu"
  fi

  setup_ddc
}

install_packages() {
  check_arch
  check_not_root
  setup_sudo

  step "Updating the system (pacman -Syu)"
  if confirm "Run a full system upgrade first? (recommended: installing on an outdated system can break it)" y; then
    run_logged sudo pacman -Syu "${PM_FLAGS[@]}"
  else
    warn "Skipping the upgrade. If a package fails with '404' or 'target not found', run: sudo pacman -Syu"
  fi

  install_yay

  step "Installing ${#PACKAGES[@]} packages with yay"
  run_logged yay -S --needed "${PM_FLAGS[@]}" "${PACKAGES[@]}"

  post_install
}

refresh_font_cache() {
  if command -v fc-cache >/dev/null 2>&1; then
    info "Refreshing font cache..."
    run fc-cache -f "$FONTS_DIR" >/dev/null 2>&1 || true
  fi
}

target_dir() {
  case "$1" in
    .config) printf '%s' "$CONFIG_DIR" ;;
    .icons)  printf '%s' "$ICONS_DIR" ;;
    .fonts)  printf '%s' "$FONTS_DIR" ;;
    *) die "Unknown label: $1" ;;
  esac
}

manifest_lookup() {
  [[ -f "$MANIFEST" ]] || return 1
  local label name had
  while IFS=$'\t' read -r label name had; do
    if [[ "$label" == "$1" && "$name" == "$2" ]]; then
      printf '%s' "$had"
      return 0
    fi
  done < "$MANIFEST"
  return 1
}

manifest_add() {
  if ((DRY_RUN)); then return 0; fi
  mkdir -p "$STATE_DIR"
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$MANIFEST"
}

init_backup_root() {
  if [[ -f "$BACKUP_REF" ]]; then
    BACKUP_ROOT="$(<"$BACKUP_REF")"
  else
    BACKUP_ROOT="$BACKUP_BASE/$(date +%Y%m%d-%H%M%S)"
    if ((DRY_RUN)); then return 0; fi
    mkdir -p "$STATE_DIR"
    printf '%s' "$BACKUP_ROOT" > "$BACKUP_REF"
  fi
}

save_preserved() {
  local -n list="$2"
  local rel
  for rel in "${list[@]}"; do
    if [[ "$rel" == "$1/"* && -e "$CONFIG_DIR/$rel" ]]; then
      if ((DRY_RUN)); then
        info "[dry-run] would keep your $rel"
      else
        mkdir -p "$PRESERVE_DIR/$(dirname "$rel")"
        cp -a "$CONFIG_DIR/$rel" "$PRESERVE_DIR/$rel"
        info "Keeping your $rel"
      fi
    fi
  done
}

restore_preserved() {
  local -n list="$2"
  local rel
  for rel in "${list[@]}"; do
    if [[ "$rel" == "$1/"* && -e "$PRESERVE_DIR/$rel" ]]; then
      mkdir -p "$CONFIG_DIR/$(dirname "$rel")"
      cp -a "$PRESERVE_DIR/$rel" "$CONFIG_DIR/$rel"
    fi
  done
}

deploy_item() {
  local src="$1" label="$2"
  local name dest_dir dest keep=""
  name="$(basename "$src")"
  dest_dir="$(target_dir "$label")"
  dest="$dest_dir/$name"

  case "$name" in .git|.gitignore|.DS_Store) return 0 ;; esac

  if manifest_lookup "$label" "$name" >/dev/null; then
    info "Updating $label/$name"
    if [[ "$label" == ".config" ]]; then
      save_preserved "$name" PRESERVE
      keep=PRESERVE
    fi
    run rm -rf "$dest"
  else
    local had=0
    if [[ -e "$dest" || -L "$dest" ]]; then
      had=1
      if [[ "$label" == ".config" ]]; then
        save_preserved "$name" KEEP_ON_FIRST
        keep=KEEP_ON_FIRST
      fi
      info "Moving existing $label/$name -> backup"
      run mkdir -p "$BACKUP_ROOT/$label"
      run mv "$dest" "$BACKUP_ROOT/$label/"
    fi
    manifest_add "$label" "$name" "$had"
    info "Installing $label/$name"
  fi

  run cp -a "$src" "$dest_dir/"

  if [[ -n "$keep" ]] && ((!DRY_RUN)); then
    restore_preserved "$name" "$keep"
  fi
}

seed_wallpaper() {
  local wp="$CONFIG_DIR/quickshell/assets/wallpaper/default-wallpaper.png"
  local state="$CONFIG_DIR/wallpaper/current"
  local apply="$CONFIG_DIR/quickshell/scripts/apply-wallpaper.sh"

  if ((DRY_RUN)); then return 0; fi

  mkdir -p "$HOME/.cache/awww"
  if [[ ! -f "$wp" ]]; then
    warn "Default wallpaper not found ($wp); skipping."
    return 0
  fi
  if [[ -f "$state" ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$state")"
  printf 'type=image\npath=%s\n' "$wp" > "$state"

  if command -v python3 >/dev/null 2>&1; then
    python3 "$CONFIG_DIR/quickshell/scripts/extract_accent.py" "$wp" >/dev/null 2>&1 \
      || warn "Could not generate theme colors from the default wallpaper."
  fi

  if [[ -n "${WAYLAND_DISPLAY:-}" && -f "$apply" ]]; then
    bash "$apply" image "$wp" >/dev/null 2>&1 \
      || warn "Could not set the wallpaper now; it will be applied at your next login."
  fi
}

check_hyprland() {
  local bin ver
  bin="$(command -v Hyprland 2>/dev/null || command -v hyprland 2>/dev/null || true)"
  if [[ -z "$bin" ]]; then
    warn "Hyprland was not found in PATH. These dotfiles need Hyprland 0.55 or newer (Lua config): sudo pacman -S hyprland"
    return 0
  fi
  ver="$("$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 || true)"
  if [[ -n "$ver" && "$(printf '%s\n0.55\n' "$ver" | sort -V | head -n1)" != "0.55" ]]; then
    warn "Hyprland $ver is too old: hypr/hyprland.lua needs 0.55 or newer. Update it: sudo pacman -Syu hyprland"
  fi
}

seed_wallpaper_dir() {
  if ((DRY_RUN)); then return 0; fi
  mkdir -p "$HOME/Pictures/Wallpapers"
}

schedule_welcome() {
  if ((DRY_RUN)); then
    return 0
  fi
  mkdir -p "$STATE_DIR"
  printf 'show\n' > "$WELCOME_PENDING"
}

spec_kv() { printf '%-17s %s\n' "$1:" "$2"; }

spec_size() {
  awk -v b="${1:-0}" 'BEGIN {
    if (b >= 1e12) printf "%.1f TB", b / 1e12
    else if (b >= 1e9) printf "%.0f GB", b / 1e9
    else printf "%.0f MB", b / 1e6
  }'
}

spec_gib() {
  awk -v b="${1:-0}" 'BEGIN {
    if (b >= 1073741824) printf "%.0f GiB", b / 1073741824
    else printf "%.0f MiB", b / 1048576
  }'
}

spec_lscpu() { awk -F: -v k="$1" '$1 == k { sub(/^[ \t]+/, "", $2); print $2; exit }' <<<"$2"; }

spec_disk_kind() {
  local name="$1" rota="$2" tran="$3"
  case "$name" in
    nvme*)    echo "NVMe SSD"; return ;;
    mmcblk*)  echo "eMMC / SD card"; return ;;
    vd*|xvd*) echo "virtual disk"; return ;;
  esac
  case "$tran" in
    nvme)     echo "NVMe SSD" ;;
    usb)      echo "USB drive" ;;
    sata|ata) if [[ "$rota" == "1" ]]; then echo "SATA HDD"; else echo "SATA SSD"; fi ;;
    *)        if [[ "$rota" == "1" ]]; then echo "HDD"; else echo "SSD (interface unknown)"; fi ;;
  esac
}

generate_specs() {
  if ((DRY_RUN)); then
    info "[dry-run] would write the PC specs to $SPEC_FILE"
    return 0
  fi

  local tmp os_name kernel boot_mode hbin hver device
  local lscpu_out cpu_model sockets cores_per threads cores
  local mem_kb swap_line
  local root_fs home_target home_fs src top rota tran rsize
  local name size type model pname psize pfs pmnt gname gdrv f b l i
  local -a gpus=() vram=()

  mkdir -p "$(dirname "$SPEC_FILE")"
  tmp="$(mktemp "$SPEC_FILE.XXXXXX")"

  os_name="$( . /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-}" )"
  kernel="$(uname -r 2>/dev/null || true) ($(uname -m 2>/dev/null || true))"
  if [[ -d /sys/firmware/efi ]]; then boot_mode="UEFI"; else boot_mode="BIOS (legacy)"; fi

  hver=""
  hbin="$(command -v Hyprland 2>/dev/null || command -v hyprland 2>/dev/null || true)"
  if [[ -n "$hbin" ]]; then
    hver="$("$hbin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 || true)"
  fi

  if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then
    device="laptop (battery found)"
  else
    device="desktop (no battery)"
  fi

  lscpu_out="$(LC_ALL=C lscpu 2>/dev/null || true)"
  cpu_model="$(spec_lscpu 'Model name' "$lscpu_out")"
  sockets="$(spec_lscpu 'Socket(s)' "$lscpu_out")"
  cores_per="$(spec_lscpu 'Core(s) per socket' "$lscpu_out")"
  threads="$(spec_lscpu 'CPU(s)' "$lscpu_out")"
  cores=""
  if [[ "${sockets:-}" =~ ^[0-9]+$ && "${cores_per:-}" =~ ^[0-9]+$ ]]; then
    cores=$((sockets * cores_per))
  fi

  mem_kb="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
  swap_line="$(swapon --noheadings --raw --bytes --show=NAME,SIZE 2>/dev/null | awk '{
    kind = ($1 ~ /^\/dev\/zram/) ? "zram" : (($1 ~ /^\/dev\//) ? "partition" : "file")
    printf "%s%.1f GiB %s", (n++ ? ", " : ""), $2 / 1073741824, kind
  }' || true)"

  while IFS='|' read -r gname gdrv; do
    if [[ -n "$gname" ]]; then gpus+=("$gname|$gdrv"); fi
  done < <(lspci -vmmk 2>/dev/null | awk -v RS= -F'\n' '{
    cls = ""; ven = ""; dev = ""; drv = ""
    for (i = 1; i <= NF; i++) {
      k = $i; sub(/:.*/, "", k)
      v = $i; sub(/^[^:]*:[ \t]*/, "", v)
      if (k == "Class") cls = v
      else if (k == "Vendor") ven = v
      else if (k == "Device") dev = v
      else if (k == "Driver") drv = v
    }
    if (cls ~ /VGA|3D|Display/) print ven " " dev "|" drv
  }' || true)

  for f in /sys/class/drm/card[0-9]/device/mem_info_vram_total; do
    if [[ -r "$f" ]]; then
      b="$(<"$f")"
      if [[ "$b" =~ ^[0-9]+$ ]]; then vram+=("$(spec_gib "$b")"); fi
    fi
  done
  if ((${#vram[@]} == 0)) && command -v nvidia-smi >/dev/null 2>&1; then
    while IFS= read -r l; do
      l="${l//[[:space:]]/}"
      if [[ "$l" =~ ^[0-9]+$ ]]; then vram+=("$(spec_gib "$((l * 1048576))")"); fi
    done < <(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null || true)
  fi

  root_fs="$(findmnt -no FSTYPE / 2>/dev/null | head -n1 || true)"
  home_target="$(findmnt -no TARGET -T /home 2>/dev/null | head -n1 || true)"
  home_fs="$(findmnt -no FSTYPE -T /home 2>/dev/null | head -n1 || true)"
  src="$(findmnt -no SOURCE / 2>/dev/null | head -n1 | sed 's/\[.*\]$//' || true)"
  top=""
  if [[ -n "$src" ]]; then
    top="$(lsblk -nslo NAME,TYPE "$src" 2>/dev/null | awk '$2 == "disk" { print $1; exit }' || true)"
  fi

  {
    echo "# PC specs for the Glassveil Shell AI panel."
    echo "# Written by ./setup on $(date +%F). Run ./setup specs again after a hardware change."
    echo "# The AI reads this file instead of running commands."
    echo "# It has no hostname, serial numbers, MAC addresses or IP addresses."
    echo "# RAM is the amount Linux can use, a little below the installed size."
    echo
    spec_kv "OS" "${os_name:-Arch Linux}"
    spec_kv "Kernel" "$kernel"
    spec_kv "Boot mode" "$boot_mode"
    spec_kv "Hyprland" "${hver:-unknown}"
    spec_kv "Device type" "$device"
    echo
    spec_kv "CPU" "${cpu_model:-unknown}"
    if [[ -n "$cores" || -n "${threads:-}" ]]; then
      spec_kv "CPU cores" "${cores:-unknown}"
      spec_kv "CPU threads" "${threads:-unknown}"
    fi
    if [[ -n "$mem_kb" ]]; then
      spec_kv "RAM" "$(awk -v k="$mem_kb" 'BEGIN { printf "%.1f GiB usable", k / 1048576 }')"
    else
      spec_kv "RAM" "unknown"
    fi
    spec_kv "Swap" "${swap_line:-none}"
    if ((${#gpus[@]} == 0)); then
      spec_kv "GPU" "unknown (none detected)"
    else
      for i in "${!gpus[@]}"; do
        gname="${gpus[$i]%%|*}"
        gdrv="${gpus[$i]#*|}"
        if ((${#gpus[@]} > 1)); then name="GPU $((i + 1))"; else name="GPU"; fi
        spec_kv "$name" "$gname (driver: ${gdrv:-none})"
      done
    fi
    for i in "${!vram[@]}"; do
      spec_kv "VRAM" "${vram[$i]} (dedicated video memory; integrated GPUs share system RAM)"
    done
    echo
    spec_kv "Root filesystem" "${root_fs:-unknown}"
    if [[ "$home_target" == "/" || -z "$home_target" ]]; then
      spec_kv "/home" "inside the root filesystem"
    else
      spec_kv "/home" "separate mount, ${home_fs:-unknown}"
    fi
    if [[ -n "$top" ]]; then
      read -r rota tran < <(lsblk -dno ROTA,TRAN "/dev/$top" 2>/dev/null || true) || true
      rsize="$(lsblk -dnbo SIZE "/dev/$top" 2>/dev/null | head -n1 || true)"
      spec_kv "System disk" "$top ($(spec_disk_kind "$top" "${rota:-}" "${tran:-}"), $(spec_size "${rsize:-0}"))"
    fi
    echo "Storage:"
    while read -r name size type rota tran; do
      if [[ "$type" != "disk" ]]; then continue; fi
      case "$name" in zram*|ram*|loop*) continue ;; esac
      model="$(lsblk -dno MODEL "/dev/$name" 2>/dev/null | sed 's/[[:space:]]*$//' || true)"
      printf '  - %s: %s, %s%s\n' "$name" "$(spec_size "$size")" "$(spec_disk_kind "$name" "$rota" "${tran:-}")" "${model:+, $model}"
      while read -r pname psize pfs pmnt; do
        printf '      %-16s %-9s %-10s %s\n' "$pname" "$(spec_size "$psize")" "${pfs:--}" "${pmnt:--}"
      done < <(lsblk -lnb -o NAME,SIZE,FSTYPE,MOUNTPOINT "/dev/$name" 2>/dev/null | tail -n +2 || true)
    done < <(lsblk -dnb -o NAME,SIZE,TYPE,ROTA,TRAN 2>/dev/null || true)
  } > "$tmp"

  chmod 600 "$tmp"
  mv -f "$tmp" "$SPEC_FILE"
  info "Saved PC specs for the AI panel: $SPEC_FILE"
}

ask_reboot() {
  if [[ "$REBOOT_MODE" != "yes" ]]; then return 0; fi
  info "Rebooting..."
  if command -v systemctl >/dev/null 2>&1; then
    run systemctl reboot
  else
    run reboot
  fi
}

do_install() {
  check_not_root
  build_flags

  local first_install=1
  if [[ -f "$MANIFEST" ]]; then first_install=0; fi

  local -a config_items=()
  local name item
  for name in "${CONFIG_DIRS[@]}"; do
    if [[ -d "$ROOT/$name" ]]; then
      config_items+=("$ROOT/$name")
    else
      warn "Config folder '$name' is listed in CONFIG_DIRS but missing from the repo; skipping."
    fi
  done
  [[ ${#config_items[@]} -gt 0 ]] || die "No config folders found in $ROOT."

  while IFS= read -r -d '' item; do
    name="$(basename "$item")"
    case "$name" in
      icons|fonts|.*) continue ;;
    esac
    if [[ " ${CONFIG_DIRS[*]} " != *" $name "* ]]; then
      info "Ignoring folder '$name' (not in CONFIG_DIRS)."
    fi
  done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

  if ((SKIP_DEPS)); then
    info "Skipping package installation (--no-deps)."
  else
    install_packages
  fi
  check_hyprland

  PRESERVE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dots-keep.XXXXXX")"
  TMP_DIRS+=("$PRESERVE_DIR")
  init_backup_root

  step "Installing dotfiles to $CONFIG_DIR"
  run mkdir -p "$CONFIG_DIR"
  for item in "${config_items[@]}"; do
    deploy_item "$item" ".config"
  done

  if [[ -d "$ROOT/icons" ]]; then
    step "Installing icons/cursors to $ICONS_DIR"
    run mkdir -p "$ICONS_DIR"
    while IFS= read -r -d '' item; do
      deploy_item "$item" ".icons"
    done < <(find "$ROOT/icons" -mindepth 1 -maxdepth 1 -print0 | sort -z)
  else
    warn "No icons folder found; skipping."
  fi

  if [[ -d "$ROOT/fonts" ]]; then
    step "Installing fonts to $FONTS_DIR"
    run mkdir -p "$FONTS_DIR"
    while IFS= read -r -d '' item; do
      deploy_item "$item" ".fonts"
    done < <(find "$ROOT/fonts" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    refresh_font_cache
  else
    warn "No fonts folder found; skipping."
  fi

  STEP="Setting the default wallpaper"
  seed_wallpaper
  seed_wallpaper_dir

  if [[ ! -f "$SPEC_FILE" ]]; then
    step "Saving PC specs for the AI panel"
    generate_specs || warn "Could not write $SPEC_FILE. You can try again later with: ./setup specs"
  fi

  if ((first_install)); then
    schedule_welcome
  fi

  STEP=""
  echo
  info "Reboot your PC."
  info "Press SUPER + / to open the cheatsheet."
  if ((first_install)); then
    info "No display manager? Install one (sudo pacman -S sddm && sudo systemctl enable sddm) or start Hyprland from the TTY."
  fi
  echo
  ask_reboot
}

do_uninstall() {
  check_not_root
  [[ -f "$MANIFEST" ]] || die "No install record found at $MANIFEST; nothing to uninstall."
  [[ -f "$BACKUP_REF" ]] || die "Backup location record is missing ($BACKUP_REF)."
  BACKUP_ROOT="$(<"$BACKUP_REF")"

  warn "Installed dotfiles will be removed (manual changes to them are lost),"
  warn "and your original configs will be restored from: $BACKUP_ROOT"
  confirm "Continue with uninstall?" || die "Cancelled."

  step "Removing dotfiles and restoring your originals"
  local label name had dest_dir dest saved
  while IFS=$'\t' read -r label name had; do
    [[ -n "$label" ]] || continue
    case "$name" in
      ""|.|..|*/*) warn "Ignoring invalid manifest entry '$label/$name'."; continue ;;
    esac
    dest_dir="$(target_dir "$label")"
    dest="$dest_dir/$name"
    saved="$BACKUP_ROOT/$label/$name"

    if [[ -e "$dest" || -L "$dest" ]]; then
      run rm -rf "$dest"
    fi

    if [[ "$had" == "1" ]]; then
      if [[ -e "$saved" || -L "$saved" ]]; then
        info "Restoring $label/$name"
        run mkdir -p "$dest_dir"
        run mv "$saved" "$dest_dir/"
      else
        warn "Backup of $label/$name not found at $saved; skipping."
      fi
    else
      info "Removing $label/$name (did not exist before)"
    fi
  done < "$MANIFEST"

  if ((DRY_RUN)); then
    info "[dry-run] done; nothing was changed."
    return 0
  fi

  rm -f "$MANIFEST" "$BACKUP_REF" "$LOG_FILE" "$WELCOME_PENDING"
  rm -f "$CONFIG_DIR/wallpaper/current" "$SPEC_FILE"
  rmdir "$CONFIG_DIR/wallpaper" 2>/dev/null || true
  refresh_font_cache
  rmdir "$STATE_DIR" 2>/dev/null || true
  find "$BACKUP_ROOT" -depth -type d -empty -delete 2>/dev/null || true
  rmdir "$BACKUP_BASE" 2>/dev/null || true
  if [[ -d "$BACKUP_ROOT" ]]; then
    warn "Leftovers remain in $BACKUP_ROOT (not created by this script); not removed."
  fi
  STEP=""
  info "Uninstall complete. Your original configs have been restored."
}

if ((!IN_PTY)); then rm -f "$LOG_FILE"; fi

CMD=""
for arg in "$@"; do
  case "$arg" in
    -y|--yes)     ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --no-deps)    SKIP_DEPS=1 ;;
    --reboot)     REBOOT_MODE="yes" ;;
    --no-reboot)  REBOOT_MODE="no" ;;
    -h|--help)    CMD="help" ;;
    -*) usage; die "Unknown option: $arg" ;;
    *)  CMD="$arg" ;;
  esac
done

NEED_PTY=0
case "${CMD:-}" in
  deps)    NEED_PTY=1 ;;
  install) if ((!SKIP_DEPS)); then NEED_PTY=1; fi ;;
esac

if ((NEED_PTY && !IN_PTY && !DRY_RUN)) && [[ -t 0 && -t 1 ]] && command -v script >/dev/null 2>&1; then
  mkdir -p "$STATE_DIR"
  : > "$LOG_FILE"
  printf -v pty_cmd '%q ' bash "$ROOT/$(basename "${BASH_SOURCE[0]}")" "$@"
  pty_rc=0
  GLASSVEIL_SETUP_PTY=1 script -qefc "$pty_cmd" "$LOG_FILE" || pty_rc=$?
  if ((pty_rc == 0)); then rm -f "$LOG_FILE"; fi
  exit "$pty_rc"
fi

case "${CMD:-help}" in
  install)   do_install ;;
  uninstall) do_uninstall ;;
  deps)      check_not_root; build_flags; install_packages ;;
  specs)     check_not_root; step "Saving PC specs for the AI panel"; generate_specs || die "Could not write $SPEC_FILE." ;;
  welcome)   check_not_root; schedule_welcome; info "Goodbye" ;;
  help)      usage ;;
  *)         usage; die "Unknown command: $CMD" ;;
esac
